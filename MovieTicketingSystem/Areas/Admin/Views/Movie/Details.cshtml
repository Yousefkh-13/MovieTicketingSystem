@model Movie

<div class="container my-4">
    <div class="card shadow-sm p-4">
        <div class="row">

            <div class="col-md-5">
                <img src="~/images/movies/@Model.MainImg" class="img-fluid rounded shadow mb-3" alt="@Model.Name" style="max-height: 400px; width: 100%; object-fit: cover;" />

                @if (Model.MovieSubImgs != null && Model.MovieSubImgs.Any())
                {
                    <div class="card-img-top">
                        @foreach (var item in Model.MovieSubImgs)
                        {
@*                             <img src="~/imgs/movies/MainImg/@item.ImageUrl" class="rounded border" width="70" height="70" style="object-fit: cover;" />
 *@
@*                             <img class="card-img-top" src="~/imgs/movies/MainImg/@item.MainImg" alt="..." />
 *@
                        }
                    </div>
                }
            </div>

            <div class="col-md-7">
                <h2 class="fw-bold text-primary">@Model.Name</h2>
                <p class="text-muted"><strong>Category:</strong> @Model.Category?.Name</p>
                <p class="text-muted"><strong>Cinema:</strong> @Model.Cinema?.Name</p>
                <p class="text-muted"><strong>Status:</strong> <span class="badge @(Model.Status ? "bg-success" : "bg-danger")">@(Model.Status ? "Available" : "Unavailable")</span></p>

                <hr />
                <h5 class="fw-bold">Description</h5>
                <p class="text-secondary">@Model.Description</p>
            </div>
        </div>

        <hr class="my-5" />

        <div>
            <h4 class="fw-bold mb-3">Cast (Actors)</h4>
            @if (Model.MovieActors != null && Model.MovieActors.Any())
            {
                <div class="row g-3">
                    @foreach (var movieActor in Model.MovieActors)
                    {
                       @*  <div class="col-6 col-md-3 col-lg-2 text-center">
                            <div class="card p-2 shadow-sm h-100">
                                <div class="bg-light rounded-circle mx-auto d-flex align-items-center justify-content-center mb-2" style="width: 70px; height: 70px;">
                                    <i class="bi bi-person-fill fs-2 text-secondary"></i>
                                </div>
                                <h6 class="fw-bold mb-0 text-dark">@movieActor.Actor.Name</h6>
                            </div>
                        </div> *@
                        <div class="col-6 col-md-3 col-lg-2 text-center">
                            <div class="card p-2 shadow-sm h-100 border-0">
                                <div class="avatar avatar-4xl mx-auto mb-2">
                                    <img class="rounded-circle" src="~/images/actors/@movieActor.Actor.Img" alt="@movieActor.Actor.Name" onerror="this.src='/images/default-avatar.png'" />
                                </div>
                                <h6 class="fw-bold mb-0 text-dark fs--1">@movieActor.Actor.Name</h6>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <p class="text-muted">No actors assigned to this movie.</p>
            }
        </div>

        <div class="mt-4">
            <a href="~/Admin/Movie" asp-action="Index" class="btn btn-secondary">Back to List</a>
        </div>
    </div>
</div>