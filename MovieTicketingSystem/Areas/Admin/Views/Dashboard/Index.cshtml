@model DashboardVM

<div class="container my-4">
    <div class="row g-3 mb-4">
        <div class="col-12">
            <h2 class="fw-bold">Dashboard Statistics</h2>
        </div>

        <div class="col-md-3">
            <div class="card bg-primary text-white p-3 shadow-sm h-100">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-uppercase fw-semibold mb-1">Total Movies</h6>
                        <h3 class="fw-bold mb-0">@Model.TotalMovies</h3>
                    </div>
                    <i class="bi bi-film fs-1 opacity-75"></i>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card bg-success text-white p-3 shadow-sm h-100">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-uppercase fw-semibold mb-1">Total Cinemas</h6>
                        <h3 class="fw-bold mb-0">@Model.TotalCinemas</h3>
                    </div>
                    <i class="bi bi-building fs-1 opacity-75"></i>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card bg-warning text-dark p-3 shadow-sm h-100">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-uppercase fw-semibold mb-1">Total Actors</h6>
                        <h3 class="fw-bold mb-0">@Model.TotalActors</h3>
                    </div>
                    <i class="bi bi-people fs-1 opacity-75"></i>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card bg-info text-white p-3 shadow-sm h-100">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-uppercase fw-semibold mb-1">Total Categories</h6>
                        <h3 class="fw-bold mb-0">@Model.TotalCategories</h3>
                    </div>
                    <i class="bi bi-tags fs-1 opacity-75"></i>
                </div>
            </div>
        </div>
    </div>
</div>